# ------------------------- Server -------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ------------------------- Database -----------------------
# Local:  mongodb://127.0.0.1:27017/careerforge
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/careerforge
MONGODB_URI=mongodb://127.0.0.1:27017/careerforge

# If set to "memory", the server starts an in-memory MongoDB (dev only).
# Leave empty to use MONGODB_URI above.
USE_MEMORY_DB=

# ------------------------- Auth ---------------------------
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ------------------------- AI provider --------------------
# Any OpenAI-compatible chat completions API.
# Examples:
#   OpenAI:    https://api.openai.com/v1     model: gpt-4o-mini
#   Anthropic: (use an OpenAI-compatible gateway) 
#   Groq:      https://api.groq.com/openai/v1 model: llama-3.1-70b-versatile
# Leave AI_API_KEY empty to use the built-in deterministic coach (no network).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ------------------------- Optional -----------------------
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
